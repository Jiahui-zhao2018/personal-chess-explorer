# Optional. Export these variables in your shell before running scripts/dev.sh.
# No credentials belong in this file; connect through Settings / OAuth.
PCE_OAUTH_CLIENT_ID=personal-chess-explorer
PCE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
PCE_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Frontend binds to all interfaces for the authenticated cloud preview proxy.
# Set PCE_DEV_HOST=127.0.0.1 if you only want local access.
PCE_DEV_HOST=0.0.0.0
# For a preview with an external Host, set PCE_FRONTEND_ORIGIN to its exact URL.
# Optional additional trusted preview hostnames (comma-separated; no scheme/port):
PCE_PREVIEW_HOSTS=
# PCE_DATA_DIR=/absolute/path/to/private/local/data
# Live writes are OFF by default. First enable ONLY an authorized disposable study.
PCE_WRITE_STUDY_IDS=
# For browser tests on a machine with system Chromium:
# PCE_CHROMIUM_PATH=/usr/bin/chromium
